root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.{yaml,yml,json,toml,xml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
